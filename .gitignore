cat << 'EOF' > .gitignore
# Environment & Secrets
.env
.env.*
!.env.example

# C++ Engine Build Artifacts
engine-cpp/build/
engine-cpp/bin/
*.o
*.obj
*.exe
*.out
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json

# Node.js / TypeScript Gateway
node_modules/
dist/
npm-debug.log*

# Python GenAI Service
__pycache__/
*.py[cod]
.venv/
venv/

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
.idea/
EOF